{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/rtg_tt_request.schema.json",
  "title": "RTG to Transition Table Bounded Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "transition_block_id",
    "candidate_transition_id",
    "current_state_ref",
    "proposed_state_ref",
    "significance_class",
    "significance_score",
    "contextual_threshold",
    "authority_refs",
    "evidence_refs",
    "reachable_state_effects",
    "requested_resolution"
  ],
  "properties": {
    "contract_version": {"const": "rtg-tt-v0.1"},
    "request_id": {"type": "string", "minLength": 1},
    "transition_block_id": {"type": "string", "minLength": 1},
    "candidate_transition_id": {"type": "string", "minLength": 1},
    "current_state_ref": {"type": "string", "minLength": 1},
    "proposed_state_ref": {"type": "string", "minLength": 1},
    "significance_class": {
      "enum": ["active", "supporting", "latent", "discardable"]
    },
    "significance_score": {"type": "number", "minimum": 0, "maximum": 1},
    "contextual_threshold": {"type": "number", "minimum": 0, "maximum": 1},
    "authority_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "reachable_state_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opens", "closes", "deformation_magnitude", "irreversible"],
      "properties": {
        "opens": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "closes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "deformation_magnitude": {"type": "number", "minimum": 0, "maximum": 1},
        "irreversible": {"type": "boolean"}
      }
    },
    "requested_resolution": {
      "enum": ["admissibility", "authority", "commit", "quarantine", "defer"]
    }
  }
}
