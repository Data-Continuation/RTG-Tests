{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/rtg/multi_trajectory_field.schema.json",
  "title": "RTG Multi-Trajectory Field",
  "type": "object",
  "required": ["field_id", "observed_at", "entity_id", "context", "candidate_transitions", "reachable_state_frontier"],
  "properties": {
    "field_id": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "entity_id": {"type": "string", "minLength": 1},
    "context": {
      "type": "object",
      "required": ["risk", "uncertainty", "capacity", "authority_complexity", "significance_threshold"],
      "properties": {
        "risk": {"type": "number", "minimum": 0, "maximum": 1},
        "uncertainty": {"type": "number", "minimum": 0, "maximum": 1},
        "capacity": {"type": "number", "minimum": 0},
        "authority_complexity": {"type": "integer", "minimum": 1},
        "significance_threshold": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "candidate_transitions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/transition"}
    },
    "reachable_state_frontier": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/reachableState"}
    },
    "geometry_deformation": {"$ref": "#/$defs/deformation"}
  },
  "$defs": {
    "scoreComponents": {
      "type": "object",
      "required": ["causal", "decision", "authority", "identity", "risk", "latent"],
      "properties": {
        "causal": {"type": "number", "minimum": 0, "maximum": 1},
        "decision": {"type": "number", "minimum": 0, "maximum": 1},
        "authority": {"type": "number", "minimum": 0, "maximum": 1},
        "identity": {"type": "number", "minimum": 0, "maximum": 1},
        "risk": {"type": "number", "minimum": 0, "maximum": 1},
        "latent": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "required": ["transition_id", "class", "score", "score_components", "coupled_transition_ids", "authority_regime", "reversible"],
      "properties": {
        "transition_id": {"type": "string", "minLength": 1},
        "class": {"enum": ["active", "supporting", "latent", "discardable"]},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "score_components": {"$ref": "#/$defs/scoreComponents"},
        "coupled_transition_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "authority_regime": {"type": "string", "minLength": 1},
        "reversible": {"type": "boolean"},
        "retention_reason": {"type": "string"},
        "supersedes": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "reachableState": {
      "type": "object",
      "required": ["state_id", "probability", "reachable_via"],
      "properties": {
        "state_id": {"type": "string", "minLength": 1},
        "probability": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "reachable_via": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      },
      "additionalProperties": false
    },
    "deformation": {
      "type": "object",
      "required": ["action_id", "closed_state_ids", "opened_state_ids", "authority_changes", "evidence_changes", "magnitude"],
      "properties": {
        "action_id": {"type": "string", "minLength": 1},
        "closed_state_ids": {"type": "array", "items": {"type": "string"}},
        "opened_state_ids": {"type": "array", "items": {"type": "string"}},
        "authority_changes": {"type": "array", "items": {"type": "string"}},
        "evidence_changes": {"type": "array", "items": {"type": "string"}},
        "magnitude": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
